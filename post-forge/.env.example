# Copy to ignored .env.local and fill credentials locally. Never use NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
SERPER_API_KEY=
GEMINI_API_KEY=
IMAGE_PROVIDER=gemini
IMAGE_MODEL=gemini-2.5-flash-image
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=postforge

# Explicit local Inngest Dev Server mode. Cloud requires false and BOTH keys.
INNGEST_DEV=true
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional finite limits: omit to use defaults in src/lib/config.ts.
# Blank values are invalid. Overrides must be decimal integers within bounds.
# TOPIC_MAX_CHARS
# ARTICLE_MAX_CHARS
# SEARCH_MAX_RESULTS
# FINDINGS_MAX_COUNT
# SOURCE_MAX_BYTES
# POSTER_MAX_BYTES
# PROVIDER_TIMEOUT_MS
# IMAGE_TIMEOUT_MS
# DATABASE_TIMEOUT_MS
# STAGE_CORRECTION_ATTEMPTS
# PROVIDER_RETRIES
# NETWORK_MAX_ITERATIONS
